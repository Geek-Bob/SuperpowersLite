#!/usr/bin/env bash
# 用法：review-package <计划文件> <任务编号> <BASE> <HEAD>
# commit 列表 + stat 摘要 + 上下文 diff 三段合一落盘，只把路径交给审查员。
# BASE 必须是派发前记录的 SHA——用 HEAD~1 会静默丢弃多 commit 任务的前序改动。
set -euo pipefail

if [ $# -ne 4 ]; then
  echo "用法：review-package <计划文件> <任务编号> <BASE> <HEAD>" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
head=$4

[ -f "$plan" ] || { echo "计划文件不存在：$plan" >&2; exit 1; }
case "$n" in ''|*[!0-9]*) echo "任务编号必须是正整数：$n" >&2; exit 2 ;; esac

git rev-parse --git-dir >/dev/null 2>&1 || { echo "当前目录不是 git 仓库" >&2; exit 1; }
git rev-parse --verify --quiet "$base^{commit}" >/dev/null || { echo "BASE 不是合法 commit：$base" >&2; exit 1; }
git rev-parse --verify --quiet "$head^{commit}" >/dev/null || { echo "HEAD 不是合法 commit：$head" >&2; exit 1; }

root=$(git rev-parse --show-toplevel)
slug=${plan##*/}
slug=${slug%.md}
outdir="$root/.superpowers/sdd/$slug"
mkdir -p "$outdir"
out="$outdir/review-$n.diff"

{
  echo "review 包 —— Task $n（$slug）"
  echo "BASE: $(git rev-parse "$base^{commit}")"
  echo "HEAD: $(git rev-parse "$head^{commit}")"
  echo "范围 commit 数: $(git rev-list --count "$base..$head")"
  echo
  echo "==================== 1. commit 列表 ===================="
  git log --oneline "$base..$head"
  echo
  echo "==================== 2. 改动概览（--stat）===================="
  git diff --stat "$base..$head"
  echo
  echo "==================== 3. 上下文 diff（-U10）===================="
  git diff -U10 "$base..$head"
} > "$out"

printf '%s\n' "$out"
